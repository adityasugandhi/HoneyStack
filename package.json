{
  "name": "honeystack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:trap": "node apps/trap/server.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i apps/trap/styles.src.css -o apps/trap/public/styles.css --minify",
    "test": "node --test tests/*.test.mjs",
    "docker:build": "sh scripts/build-trap.sh",
    "smoke": "sh scripts/smoke.sh",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:ping": "node --env-file-if-exists=.env scripts/ping.mjs",
    "demo:seed": "node --env-file-if-exists=.env scripts/load-fixture.mjs",
    "make:fixture": "node scripts/make-fixture.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "zod": "^4.6.5"
  }
}
