{
  "name": "honeystack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:shell": "tsx --env-file-if-exists=.env scripts/dev-control.ts",
    "shell:repl": "tsx --env-file-if-exists=.env scripts/shell-repl.ts",
