{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["apps/control/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "packages/**/*.ts"]
}
