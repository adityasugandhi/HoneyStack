# Copy to .env and fill in. Never commit .env. Names from docs/contracts.md.

# Trap (A)
PORT=
CONTROL_URL=
INGEST_TOKEN=
CALLBACK_ALLOWLIST=
TRAP_INSTANCE_ID=

# ClickHouse (C, D)
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Shell brain (B): SHELL_BACKEND=guild sends LLM commands to the honeystack-shell Guild agent;
# SHELL_BACKEND=anthropic (default) calls the Anthropic API directly with LLM_API_KEY.
SHELL_BACKEND=
GUILD_SHELL_TRIGGER_KEY=
LLM_API_KEY=
LLM_MODEL=

# Guild analysis (E): GUILD_TRIGGER_KEY is the "<api_key_id>:<api_key_secret>" pair from the API trigger
GUILD_TRIGGER_KEY=
GUILD_OWNER=
GUILD_WORKSPACE=

# Dashboard + /v1/analyze operator login (D, E)
CONTROL_TOKEN=
