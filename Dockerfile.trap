# TODO: pin the base image digest for the final demo artifact.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --chown=node:node apps/trap/server.mjs ./server.mjs
COPY --chown=node:node apps/trap/public ./public
COPY --chown=node:node packages/trap/response-map.json ./response-map.json
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
